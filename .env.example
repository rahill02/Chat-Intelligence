# Chat Intelligence Configuration

# API Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Configuration (gemini | openai | mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Embedding Configuration
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=backend/indexes/chat_faiss.index
METADATA_STORE_PATH=backend/indexes/metadata.json

# SQLite Database
DATABASE_URL=sqlite:///./backend/data/chat_intelligence.db
